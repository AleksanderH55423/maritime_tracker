# Copy this file to a new file named .env and fill it in. Get a free key at https://aisstream.io
AISSTREAM_API_KEY=your_key_here

PORT=3000

# One or more [[lat, lon], [lat, lon]] corner pairs.
# Default: English Channel + southern North Sea. Start small!
BOUNDING_BOXES=[[[48,-6],[56,10]]]

# Drop vessels we haven't heard from in this many minutes
STALE_MINUTES=60

# Set to 1 to print the first message of each type (great for learning the data shape)
# LOG_SAMPLES=1

# Point at the local mock feed instead of the real one (run `npm run mock`)
# AIS_URL=ws://localhost:9999/v0/stream
